enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  provider          String        // e.g. "STRIPE"
  providerPaymentId String        @unique // e.g. "cs_test_..." or "pi_..."
  providerEventId   String?       @unique // Used for Webhook Idempotency (the latest event ID processed)

  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")

  metadata          Json?         // Stores debugging or provider specific states (NOT business critical)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}
